{
  "name": "vgon-ponto-agent",
  "version": "1.0.4",
  "description": "VGON PONTO Agent Local (MODELO B) — iDFace LAN -> SQLite fila -> HTTPS API idempotente + Command Queue polled",
  "private": true,
  "author": "Vgon Soluções",
  "license": "Proprietary",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:mock": "set MOCK=true&& tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start:dist": "node dist/index.js",
    "ui": "node dist/ui-launcher.js",
    "installer": "powershell -ExecutionPolicy Bypass -File installer/build-installer.ps1"
  },
  "dependencies": {
    "axios": "^1.7.7",
