# ===== Ambiente =====
NODE_ENV=development
TZ=America/Sao_Paulo
APP_URL=http://localhost:3000

# ===== Banco de Dados PostgreSQL =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vgon_ponto?schema=public"

# ===== Autenticação / Sessão =====
# NextAuth v5 (Auth.js)
AUTH_SECRET="coloque-um-segredo-longo-e-aleatorio-aqui-producao"
AUTH_URL=http://localhost:3000

# ===== Segurança =====
# Segredo para geração de tokens dos Agents (não compartilhar)
AGENT_TOKEN_PEPPER="coloque-outro-segredo-aqui"

# ===== Seed (desenvolvimento) =====
# Usuário MASTER inicial criado pelo seed
SEED_MASTER_EMAIL="master@vgon.com.br"
SEED_MASTER_PASSWORD="Mudar@123"
SEED_MASTER_NAME="Master Vgon"

# ===== iDFace (para referência / debug) =====
# OBS: credenciais do equipamento NÃO são armazenadas no servidor web.
# Ficam no VGON PONTO Agent (Windows local).
# IDFACE_URL=http://192.168.x.x
# IDFACE_PORT=80
# IDFACE_USER=admin
# IDFACE_PASSWORD=

# ===== Outros =====
# Upload local temporário (substitua por S3/R2 em produção)
UPLOAD_DIR="./storage/uploads"

# ===== Deploy / EasyPanel (exemplo) =====
# EASYPANEL_APP_NAME=vgon-ponto
# EASYPANEL_DOMAIN=ponto.vgon.com.br
